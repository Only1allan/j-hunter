# Copy to .env and fill in. .env is gitignored.

# --- Required ----------------------------------------------------------------

# SiliconFlow — OpenAI-compatible API. The sole LLM provider.
# Get a key at https://cloud.siliconflow.cn
SILICONFLOW_API_KEY=

# --- Optional job sources ----------------------------------------------------
# A missing key disables that source with a warning rather than failing the run.
# Everything below is free; several need only a registration, not a payment.

# Adzuna — free tier, 1000 calls/month. The only aggregator with a South African
# endpoint alongside broad EU/US coverage. https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# ReliefWeb — free, 1000 calls/day, but the appname must be PRE-APPROVED; an
# arbitrary string is rejected with a 403. Register at
# https://apidoc.reliefweb.int/parameters#appname
# Worth doing: this is the best source of Nairobi-based UN/NGO/research technical
# roles, which pay international rather than local rates and appear on no other
# board in this pipeline.
RELIEFWEB_APPNAME=

# EXA semantic search — https://exa.ai (free tier)
EXA_API_KEY=

# Apify actors for LinkedIn/Indeed. Disabled by default regardless of this key:
# scraping those sites breaches their terms of service. Opt in per run with
#   jobapp scrape --source apify
APIFY_TOKEN=

# --- Optional enrichment -----------------------------------------------------

# GitHub personal access token (no scopes needed for public data). Raises the
# search rate limit from 10 to 30 requests/minute, which is the difference
# between researching a handful of employers and researching all of them.
# Used by the open-source contribution finder in each application package.
GITHUB_TOKEN=

# --- Optional overrides ------------------------------------------------------

# Absolute path to the HTML CV that `jobapp ingest` parses. Defaults to a path
# under the original author's home directory, so set this on any other machine.
JOBAPP_CV_HTML=

# SiliconFlow model and base URL. Defaults are fine.
# SILICONFLOW_BASE=https://api.siliconflow.com/v1
# SILICONFLOW_MODEL=zai-org/GLM-5.2
